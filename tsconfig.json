{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2023",
    "lib": ["ES2023"],
    "outDir": "./dist",
    // TypeScript 6 ya no incluye automáticamente los tipos de @types/*; hay que declararlos.
    "types": ["node", "jest"],
    "sourceMap": true,
    "declaration": false,
    // Sin "incremental": el .tsbuildinfo queda fuera de dist/, y como Nest borra dist/ en cada build,
    // TypeScript creía que ya estaba compilado y no emitía nada.

    // Necesarios para la inyección de dependencias de Nest: los decoradores leen los tipos en tiempo de ejecución.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // Los DTOs de class-validator se rellenan desde el body, no desde un constructor.
    "strictPropertyInitialization": false,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*"]
}
